{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--project", "${CLAUDE_PROJECT_DIR}", "jevmem", "hook", "session-start"],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--project", "${CLAUDE_PROJECT_DIR}", "jevmem", "hook", "user-prompt"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
