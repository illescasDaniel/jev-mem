# Example env file for jevmem
# Copy to ~/.jevmem/.env (recommended, all projects) or ./.env (this repo only).
# Windows: %USERPROFILE%\.jevmem\.env
#
# Hosted Jev (TypeSafe). Leave blank until you have a key; stats/list/forget still work.
TYPESAFE_API_KEY=replace-me
#
# Optional: local/third-party decision model instead of hosted Jev (no TYPESAFE_API_KEY needed):
# JEVMEM_BASE_URL=http://localhost:11435
# JEVMEM_MODEL=jevk5:4b
# JEVMEM_API_KEY=
# JEVMEM_TIMEOUT=60
#
# Optional overrides:
# JEVMEM_DB=
# JEVMEM_SCOPE=global
# JEVMEM_EMBEDDER=fastembed
# JEVMEM_INDEX=auto
