{
  "mcpServers": {
    "jev": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@jkudish/jev-mcp"],
      "envFile": "${userHome}/.jevmem/.env"
    },
    "jevmem": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}",
        "jevmem-mcp"
      ],
      "env": {
        "JEVMEM_SCOPE": "project:jev-mem"
      },
      "envFile": "${userHome}/.jevmem/.env"
    }
  }
}
